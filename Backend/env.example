# Copy this file to Backend/.env and replace the example values.
APP_ENV=production
RANGETRUE_API_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=https://your-frontend-domain.example

# Runtime configuration
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_RETRIES=2
ROUTE_CACHE_TTL_SECONDS=900
ELEVATION_CACHE_TTL_SECONDS=86400
UPSTREAM_CACHE_MAX_ENTRIES=512
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPENTOPO_ELEVATION_URL=https://api.opentopodata.org/v1/srtm90m
